# Скопируйте файл как .env и заполните только нужные источники.
# .env исключён из git. Никогда не коммитьте реальные ключи.

JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
HH_USER_AGENT=
HH_ACCESS_TOKEN=
# Вместо HH_ACCESS_TOKEN можно указать пару ниже для автоматического получения токена приложения.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Telegram-уведомления: создайте бота через @BotFather, напишите ему /start
# и укажите ID личного чата или канала. Токен никогда не попадает в браузер.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательные настройки
ENABLE_DEMO_SOURCE=false
AGGREGATOR_CACHE_MS=900000
REFRESH_INTERVAL_MS=900000
REQUEST_TIMEOUT_MS=8000
ATS_REQUEST_TIMEOUT_MS=30000
ATS_INDEX_PAGE_SIZE=20
ATS_DETAIL_CONCURRENCY=4
MAX_JOBS_PER_SOURCE=100
MAX_JOBS_SCANNED_PER_SOURCE=500
NOTIFICATION_MAX_JOBS=5
NOTIFICATION_MAX_ATTEMPTS=8
