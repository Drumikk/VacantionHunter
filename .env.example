# Скопируйте файл как .env и заполните только нужные источники.
# .env исключён из git. Никогда не коммитьте реальные ключи.

JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
CAREERONESTOP_USER_ID=
CAREERONESTOP_API_TOKEN=
NAV_API_TOKEN=
# Только локальный эксперимент: NAV сам получает вращающийся публичный токен. Для production используйте NAV_API_TOKEN.
NAV_USE_PUBLIC_TOKEN=false
NAV_LOOKBACK_DAYS=180
NAV_MAX_FEED_PAGES_PER_SYNC=5
JOBMARKET_FINLAND_API_KEY=
JOBMARKET_FINLAND_MAX_RESPONSE_BYTES=64000000

# ReliefWeb Jobs: с ноября 2025 года нужен предварительно одобренный appname.
RELIEFWEB_APPNAME=
ADZUNA_APP_ID=
ADZUNA_API_KEY=
# Доступны: gb,us,at,au,be,br,ca,ch,de,es,fr,it,mx,nl,nz,pl. Больше стран = больше расход дневной квоты.
ADZUNA_COUNTRIES=gb,us,at,au,be,br,ca,ch,de,es,fr,it,mx,nl,nz,pl
REED_API_KEY=
SUPERJOB_SECRET_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Для постоянного использования зарегистрируйте приложение The Muse: endpoint может отвечать анонимно,
# но действующие API Terms требуют регистрации приложения; ключ также повышает лимит.
THE_MUSE_API_KEY=
THE_MUSE_PAGES=2
# Обычно не нужен: публичные SmartRecruiters Posting API endpoints работают без авторизации.
# Заполняйте только ключом собственной организации из SmartRecruiters Credential Manager.
SMARTRECRUITERS_API_KEY=
HH_USER_AGENT=
HH_ACCESS_TOKEN=
# Вместо HH_ACCESS_TOKEN можно указать пару ниже для автоматического получения токена приложения.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Импорт официальных email-уведомлений HH. Используйте отдельный ящик и пароль приложения,
# не основной пароль почты. Для Gmail: imap.gmail.com:993, SSL/TLS.
HH_EMAIL_IMAP_HOST=imap.gmail.com
HH_EMAIL_IMAP_PORT=993
HH_EMAIL_IMAP_SECURE=true
HH_EMAIL_IMAP_USER=
HH_EMAIL_IMAP_PASSWORD=
HH_EMAIL_IMAP_FOLDER=INBOX
HH_EMAIL_SENDER_DOMAINS=hh.ru,headhunter.ru
HH_EMAIL_LOOKBACK_DAYS=30

# Telegram-уведомления: создайте бота через @BotFather, напишите ему /start
# и укажите ID личного чата или канала. Токен никогда не попадает в браузер.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательные настройки
HOST=127.0.0.1
PORT=4173
ENABLE_LIVE_SOURCES=true
ENABLE_DEMO_SOURCE=false
AGGREGATOR_CACHE_MS=900000
REFRESH_INTERVAL_MS=900000
REQUEST_TIMEOUT_MS=8000
ATS_REQUEST_TIMEOUT_MS=30000
ATS_INDEX_PAGE_SIZE=20
ATS_DETAIL_CONCURRENCY=4
SOURCE_CONCURRENCY=16
MAX_JOBS_PER_SOURCE=100
MAX_JOBS_SCANNED_PER_SOURCE=500
RECRUITEE_BOARDS=
WORKABLE_BOARDS=
PERSONIO_BOARDS=
SMARTRECRUITERS_COMPANIES=
NOTIFICATION_MAX_JOBS=5
NOTIFICATION_MAX_ATTEMPTS=8
